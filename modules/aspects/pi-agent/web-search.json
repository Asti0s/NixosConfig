{
  "tinyfishApiKey": "!/run/current-system/sw/bin/cat /run/secrets/TINYFISH_API_KEY",
  "exaApiKey": "!/run/current-system/sw/bin/cat /run/secrets/EXA_API_KEY",
  "workflow": "none",
  "searchRouting": {
    "providers": [
      "tinyfish",
      "exa"
    ],
    "fallbackOn": [
      "transient",
      "quota",
      "network",
      "invalid-response"
    ]
  },
  "fetchRouting": {
    "providers": [
      "tinyfish",
      "exa"
    ],
    "allowRemoteHostedProviders": true,
    "fallbackOn": [
      "transient",
      "quota",
      "network",
      "invalid-response"
    ]
  }
}
